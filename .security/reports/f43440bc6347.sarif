        {
          "ruleId": "A04",
          "message": {
            "text": "_input_entry reads a whole file with open() and read(), with no size cap and no no-follow guard, where every other input read uses the 16 MiB cap and no-follow reader. The risk-score stage reaches it through an operator-named --risk-scores file that nothing else reads first."
          },
