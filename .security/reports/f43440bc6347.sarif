        {
          "ruleId": "A01",
          "message": {
            "text": "atomic_write closes the temp file and then calls os.chmod on its path, so a link swapped in at that name in the output directory would have its target's mode changed. It also reads the umask by setting it to 0 and restoring it. Both need write access to the output directory."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/tachi_parts.py"
                },
                "region": {
