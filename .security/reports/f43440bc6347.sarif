              },
              "helpUri": "https://owasp.org/Top10/"
            },
            {
              "id": "A01",
              "name": "Broken Access Control",
              "shortDescription": {
                "text": "Link-following and permission handling on paths the program creates (CWE-367)"
              },
              "helpUri": "https://owasp.org/Top10/"
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "A04",
          "message": {
            "text": "The Section 7 numbered-list reader splits each bold lead with an unanchored pattern (_TITLE_SEPARATOR, then a plus-sign split). A run of n whitespace characters costs O(n^2): 40,000 characters took 9.2 s through parse_reference_set, scaling 16x per 4x length, and input is capped at 16 MiB rather than per line."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "scripts/tachi_parsers.py"
                },
                "region": {
