                  "access-control",
                  "owasp",
                  "cwe"
                ],
                "security-severity": "<max-residual-score-for-elevation-of-privilege-findings>"
              },
              "relationships": [
                {
                  "target": { "id": "A01", "toolComponent": { "name": "OWASP" } },
                  "kinds": ["relevant"]
                },
                {
                  "target": { "id": "CWE-269", "toolComponent": { "name": "CWE" } },
                  "kinds": ["relevant"]
                }
