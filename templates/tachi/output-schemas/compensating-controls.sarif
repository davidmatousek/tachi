                }
              }
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "<tachi-plh/1-hash-16-hex-digits-then-:1>",
            "findingId/v1": "I-3"
          },
          "properties": {
            "security-severity": "<residual-score-as-numeric-string>",
            "control-status": "partial",
            "control-evidence": [
              {
                "file": "<control-evidence-file-path>",
                "line": 42,
                "snippet": "<code-snippet>"
              }
            ],
            "control-carry-forward": false,
            "control-effectiveness": "moderate",
            "inherent-risk": "<original-composite-score-from-risk-scores>",
            "residual-risk": "<calculated-residual-score>",
            "maestro-layer": "<maestro-layer-name-or-Unclassified>",
            "recommendation": "<what-to-implement-text-of-the-section-4-block>",
            "effort-estimate": "Medium",
            "integrity-flags": [],
            "correlation-group": "CG-1",
            "correlation-role": "primary",
            "correlation-primary": "I-3"
          }
        },
        {
          "_comment": "Correlation group example, 2 of 2: a peer. A peer is assessed on its own: its control status, evidence and residual score are its own, and its correlation properties name its group and its primary. Its message ends with the sentence that names the group and its primary, and the sentence is not identity.",
          "ruleId": "tachi/stride/tampering",
          "message": {
