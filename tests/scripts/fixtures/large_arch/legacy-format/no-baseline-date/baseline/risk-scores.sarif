          },
          "properties": {
            "security-severity": "6.2",
            "cvss-base-score": "7.2",
            "cvss-vector": "CVSS:3.1/AV:N/AC:L/PR:N/UI:N/S:C/C:L/I:L/A:N",
            "exploitability": "6.5",
