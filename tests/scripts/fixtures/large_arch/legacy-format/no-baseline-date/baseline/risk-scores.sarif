            "maestro-layer": "L4 \u2014 Deployment Infrastructure",
            "affected_assets": []
          }
        },
        {
          "ruleId": "tachi/stride/tampering",
          "message": {
            "text": "Replay of an earlier valid update to free-text shipment requests reaches intake-agent because updates carry no nonce or expiry, restoring a state the owner already corrected.",
            "markdown": "Add a nonce and a short expiry to every update accepted by intake-agent, store seen nonces for the validity window and reject any repeat."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
