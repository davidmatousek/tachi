        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "embedded documents and metadata held by vector-store-a are readable by any service in the Data Zone that shares the same network role, because access is granted by network position.",
            "markdown": "Grant access to embedded documents and metadata per workload identity with least privilege, enforce it at vector-store-a and remove network-position trust within the Data Zone."
          },
          "level": "warning",
          "locations": [
