        {
          "ruleId": "tachi/stride/elevation-of-privilege",
          "message": {
            "text": "Role claims carried in the refresh token presented to auth-broker are honoured without confirmation against the authoritative directory.",
            "markdown": "Resolve roles for auth-broker from the authoritative directory on each request or from a short cache, and ignore role claims supplied by the caller."
          },
          "level": "warning",
