        {
          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "A shared or long-lived bearer token on edge-gateway lets anyone who obtains one copy authenticate as every tenant that uses the same deployment profile.",
            "markdown": "Replace the shared bearer token with per-workload identities that rotate automatically, and alert when one identity authenticates from two networks within the rotation window."
          },
          "level": "error",
