        {
          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "A slow-read attack holds connections to worker-2 open and ties up the workers handling work orders and route candidates until none remain for real requests.",
            "markdown": "Apply idle and total timeouts on every connection to worker-2, bound workers per client and move slow clients to a separate pool."
          },
          "level": "warning",
