        {
          "ruleId": "tachi/stride/elevation-of-privilege",
          "message": {
            "text": "edge-gateway runs with broader permissions than its function needs, so a flaw in handling inbound API requests yields access to unrelated resources.",
            "markdown": "Reduce the permissions of edge-gateway to the minimum for inbound API requests, drop capabilities it does not use and review the grants on a schedule."
          },
          "level": "error",
