        {
          "ruleId": "tachi/stride/repudiation",
          "message": {
            "text": "Operators approve changes to work orders and draft documents through a chat message or ticket comment that is not bound to the executed change, so approvals can be disputed.",
            "markdown": "Bind each approval to the exact change hash it covers, record approver and time in the audit ledger and refuse to execute unbound changes."
          },
          "level": "note",
