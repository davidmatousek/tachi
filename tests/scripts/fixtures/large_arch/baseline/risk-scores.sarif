          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "Retry storms from worker-2 multiply the load on router-agent when it slows down, turning a brief delay into a sustained outage.",
            "markdown": "Add jittered exponential backoff and a retry budget to worker-2, and enable a circuit breaker so that router-agent can recover."
          },
          "level": "note",
          "locations": [
