        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "Verbose error responses from model-gateway reveal internal paths, query text and identifiers of prompts and completions to any caller who can trigger a failure. The weakness sits at layer Foundation Model of the stack, so every workflow that depends on prompts and completions inherits the exposure. The exposed material can be reused for follow-on attacks and may trigger notification duties if it covers customer data. Rated HIGH likelihood because the path needs no special position and uses interfaces that are exposed by design, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Return generic error codes from model-gateway, log the detail on the server only and strip stack traces and identifiers from every external response. Verify the control in a pre-production exercise and review it again after any change to model-gateway."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
