        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "Secrets such as the model API key for model-gateway appear in process arguments and environment dumps that diagnostic tooling captures. model-gateway runs in the Agent Runtime Zone and exchanges prompts and completions with planner-agent over HTTPS (TLS 1.3), so anything able to reach planner-agent can also reach this weakness. Disclosure is silent, so the affected parties learn about it only when the information is misused. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and HIGH impact because the affected data or action is central to shipment handling and hard to reverse.",
            "markdown": "Pass the model API key to model-gateway through a secret manager mount, exclude it from process listings and diagnostics, and rotate it after any exposure. Verify the control in a pre-production exercise and review it again after any change to model-gateway."
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
