        {
          "ruleId": "tachi/stride/tampering",
          "message": {
            "text": "Unsanitised subtask assignments reach router-agent and are processed as trusted structure, so crafted input changes how later steps interpret the record. The weakness sits at layer Agent Framework of the stack, so every workflow that depends on subtask assignments inherits the exposure. Altered data is then treated as authoritative by every consumer, so the damage spreads before anyone compares it with the source. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Validate subtask assignments against a strict schema at the boundary of router-agent, reject unknown fields and normalise encodings before any downstream use. Name an owner for this control, review it each quarter and route violations to trace-collector so that responders see them in one place."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "router-agent",
                  "fullyQualifiedName": "Agent Runtime Zone/router-agent",
                  "kind": "process"
                }
              ]
            }
          ],
