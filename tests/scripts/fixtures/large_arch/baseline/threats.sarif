        {
          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "Retry storms from feature-store-2 multiply the load on summarizer-llm when it slows down, turning a brief delay into a sustained outage. feature-store-2 trusts summarizer-llm to pass shipment records fed into summaries along unchanged, which removes the second chance to catch the problem downstream. Operators lose the ability to book or amend shipments while the condition lasts, and recovery depends on manual intervention. Rated HIGH likelihood because the path needs no special position and uses interfaces that are exposed by design, and HIGH impact because the affected data or action is central to shipment handling and hard to reverse.",
            "markdown": "Add jittered exponential backoff and a retry budget to feature-store-2, and enable a circuit breaker so that summarizer-llm can recover. Verify the control in a pre-production exercise and review it again after any change to summarizer-llm."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
