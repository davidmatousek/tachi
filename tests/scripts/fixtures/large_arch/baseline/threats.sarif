        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "Backups of task history and operator preferences taken from memory-store are stored unencrypted in a shared location that wider operations staff can read. memory-store runs in the Data Zone and exchanges task history and operator preferences with planner-agent over PostgreSQL over TLS, so anything able to reach planner-agent can also reach this weakness. Disclosure is silent, so the affected parties learn about it only when the information is misused. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Encrypt backups of task history and operator preferences with keys held outside the storage account, restrict the location to the recovery role and audit every read. Add a regression test for this abuse path to the CI suite and alert through trace-collector when the control fires."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
