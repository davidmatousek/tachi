        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "inbound API requests held by edge-gateway are readable by any service in the Edge DMZ that shares the same network role, because access is granted by network position. Because edge-gateway serves the Edge DMZ, a single failure here reaches each consumer of inbound API requests at once. Disclosure is silent, so the affected parties learn about it only when the information is misused. Rated MEDIUM likelihood because the path needs a foothold on a neighbouring service or a prepared request, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Grant access to inbound API requests per workload identity with least privilege, enforce it at edge-gateway and remove network-position trust within the Edge DMZ. Name an owner for this control, review it each quarter and route violations to trace-collector so that responders see them in one place."
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
