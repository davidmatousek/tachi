        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "credential assertions and session grants held by auth-broker are readable by any service in the Edge DMZ that shares the same network role, because access is granted by network position. auth-broker runs in the Edge DMZ and exchanges credential assertions and session grants with policy-engine over gRPC over mTLS, so anything able to reach policy-engine can also reach this weakness. Disclosure is silent, so the affected parties learn about it only when the information is misused. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Grant access to credential assertions and session grants per workload identity with least privilege, enforce it at auth-broker and remove network-position trust within the Edge DMZ. Track coverage of this control as a release criterion for auth-broker and record any exception with an expiry date."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "auth-broker",
                  "fullyQualifiedName": "Edge DMZ/auth-broker",
                  "kind": "process"
                }
              ]
            }
          ],
          "partialFingerprints": {
