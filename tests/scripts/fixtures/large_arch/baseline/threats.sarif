        {
          "ruleId": "tachi/stride/repudiation",
          "message": {
            "text": "Delegated actions performed by planner-agent on behalf of a user are recorded under the service identity alone, hiding who authorised them. The weakness sits at layer Agent Framework of the stack, so every workflow that depends on task plans and tool selections inherits the exposure. Without reliable records an investigation cannot establish who acted, so disputes about responsibility stay unresolved. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and LOW impact because the effect is contained and easy to reverse once it is noticed.",
            "markdown": "Carry the originating user and the approval reference through every delegated call made by planner-agent, and record both in the audit entry. Track coverage of this control as a release criterion for planner-agent and record any exception with an expiry date."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "planner-agent",
                  "fullyQualifiedName": "Agent Runtime Zone/planner-agent",
                  "kind": "process"
                }
              ]
            }
          ],
