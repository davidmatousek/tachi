        {
          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "A single oversized or deeply nested payload makes auth-broker spend disproportionate memory and CPU parsing credential assertions and session grants. Because auth-broker serves the Edge DMZ, a single failure here reaches each consumer of credential assertions and session grants at once. The outage propagates to dependent agents, which stall or retry and prolong the disruption. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Cap payload size, nesting depth and parse time in auth-broker, and reject requests that exceed the limits before allocation. Name an owner for this control, review it each quarter and route violations to trace-collector so that responders see them in one place."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "auth-broker",
                  "fullyQualifiedName": "Edge DMZ/auth-broker",
                  "kind": "process"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "6f8f310aa766a04d",
            "findingId/v1": "D-2",
            "baselineRunId": "2026-09-21T09-12-00"
          },
          "properties": {
