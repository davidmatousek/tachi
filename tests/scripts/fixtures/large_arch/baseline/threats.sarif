        {
          "ruleId": "tachi/ai/llm-threats",
          "message": {
            "text": "Model output from model-gateway is inserted into a rendered page without encoding, so crafted output executes script in an operator's browser. model-gateway runs in the Agent Runtime Zone and exchanges prompts and completions with planner-agent over HTTPS (TLS 1.3), so anything able to reach planner-agent can also reach this weakness. Downstream components cannot tell the model's output from validated input, so no later layer is likely to catch it. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and HIGH impact because the affected data or action is central to shipment handling and hard to reverse.",
            "markdown": "Encode model output from model-gateway for its destination, render it as text by default and apply a content security policy that blocks inline script. Track coverage of this control as a release criterion for model-gateway and record any exception with an expiry date."
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
