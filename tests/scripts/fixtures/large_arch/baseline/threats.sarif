        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "Backups of task plans and tool selections taken from planner-agent are stored unencrypted in a shared location that wider operations staff can read. The exposure follows from how planner-agent receives task plans and tool selections from trace-collector and hands them to the next stage without an independent check. Disclosure is silent, so the affected parties learn about it only when the information is misused. Rated LOW likelihood because the path needs several preconditions to line up, such as insider access or a rare timing window, and LOW impact because the effect is contained and easy to reverse once it is noticed.",
            "markdown": "Encrypt backups of task plans and tool selections with keys held outside the storage account, restrict the location to the recovery role and audit every read. Confirm the fix with a targeted test against planner-agent, and keep the evidence with the change record for later audits."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
