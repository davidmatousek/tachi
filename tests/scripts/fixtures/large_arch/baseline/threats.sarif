        {
          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "Unbounded growth of stored prompts and completions on model-gateway fills its volume, after which writes fail for every other consumer. planner-agent trusts model-gateway to pass prompts and completions along unchanged, which removes the second chance to catch the problem downstream. The outage propagates to dependent agents, which stall or retry and prolong the disruption. Rated MEDIUM likelihood because the path needs a foothold on a neighbouring service or a prepared request, and MEDIUM impact because the effect is bounded to one workflow or one tenant and can be corrected with effort.",
            "markdown": "Set quotas and retention for prompts and completions on model-gateway, alert at eighty percent capacity and reserve space for control-plane writes. Track coverage of this control as a release criterion for model-gateway and record any exception with an expiry date."
          },
          "level": "warning",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
