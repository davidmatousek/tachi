        {
          "ruleId": "tachi/ai/agentic-threats",
          "message": {
            "text": "Memory written by planner-agent is trusted on later runs, so one poisoned entry changes the behaviour of every future task. planner-agent runs in the Agent Runtime Zone and exchanges task plans and tool selections with memory-store over PostgreSQL over TLS, so anything able to reach memory-store can also reach this weakness. Actions taken by the agent look legitimate in the logs, which slows detection and complicates rollback. Rated MEDIUM likelihood because the path needs a foothold on a neighbouring service or a prepared request, and HIGH impact because the affected data or action is central to shipment handling and hard to reverse.",
            "markdown": "Tag memory entries with provenance and trust level, sanitise them on read and let operators review and expire entries written by planner-agent. Name an owner for this control, review it each quarter and route violations to trace-collector so that responders see them in one place."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "planner-agent",
                  "fullyQualifiedName": "Agent Runtime Zone/planner-agent",
                  "kind": "process"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "eded79e55e7b3f26",
            "findingId/v1": "AG-6",
            "baselineRunId": "2026-09-21T09-12-00"
          },
          "properties": {
            "baselineState": "unchanged",
