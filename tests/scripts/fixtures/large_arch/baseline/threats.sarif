        {
          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "A slow-read attack holds connections to auth-broker open and ties up the workers handling credential assertions and session grants until none remain for real requests. The exposure follows from how auth-broker receives credential assertions and session grants from edge-gateway and hands them to the next stage without an independent check. Operators lose the ability to book or amend shipments while the condition lasts, and recovery depends on manual intervention. Rated MEDIUM likelihood because the path needs a foothold on a neighbouring service or a prepared request, and HIGH impact because the affected data or action is central to shipment handling and hard to reverse.",
            "markdown": "Apply idle and total timeouts on every connection to auth-broker, bound workers per client and move slow clients to a separate pool. Confirm the fix with a targeted test against auth-broker, and keep the evidence with the change record for later audits."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "auth-broker",
                  "fullyQualifiedName": "Edge DMZ/auth-broker",
                  "kind": "process"
                }
              ]
            }
          ],
          "partialFingerprints": {
