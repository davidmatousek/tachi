                "snippet": "def record(event):\n    entry = {\"at\": utc_now(), \"who\": event.principal, \"what\": event.action}\n    entry[\"prev\"] = ledger.tail_hash()\n    ledger.append(entry)\n    return entry[\"prev\"]"
