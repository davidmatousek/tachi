        {
          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "credential assertions and session grants held by auth-broker are readable by any service in the Edge DMZ that shares the same network role, because access is granted by network position. [Control: missing]"
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
