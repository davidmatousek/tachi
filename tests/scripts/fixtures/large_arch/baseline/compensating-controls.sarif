                "snippet": "def verify_token(raw, keys, audience):\n    claims = decode_signed(raw, keys, algorithms=[\"ES256\"])\n    if claims[\"aud\"] != audience or claims[\"exp\"] < now():\n        raise Rejected(\"token not valid for this service\")\n    return claims"
