          "partialFingerprints": {
            "primaryLocationLineHash": "1e8f683117c86c29",
            "findingId/v1": "I-4"
          },
          "properties": {
            "security-severity": "7.4",
            "control-status": "missing",
            "control-evidence": [],
            "control-carry-forward": false,
            "control-effectiveness": "none",
            "maestro-layer": "L6 \u2014 Security and Compliance",
            "inherent-risk": "7.4",
            "residual-risk": "7.4",
            "recommendation": "Implement encryption for auth-broker. Protect this data in transit and at rest with current protocols and keys held outside the storage account. Place the control where credential assertions and session grants are first received, so that nothing downstream has to repeat the check. This addresses: credential assertions and session grants held by auth-broker are readable by any service in the Edge DMZ that shares the same network role, because access is granted by network position. Acceptance check: a scan of the link or store shows only current protocol versions and encrypted content, and keys rotate without downtime. Coordinate the change with the owners of dependent services so that none of them relies on the behaviour being removed. Suggested location: stub-codebase/src/auth_broker/encryption.py. Reference patterns: TLS 1.3, envelope encryption, managed key service.",
            "effort-estimate": "Medium"
          }
        },
