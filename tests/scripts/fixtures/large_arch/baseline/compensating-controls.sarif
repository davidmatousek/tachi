          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "A compromised peer presents a forged service identity to partner-feed, and partner-feed accepts the claim without verifying the signature chain back to the issuing authority. [Control: missing]"
          },
          "level": "error",
          "locations": [
