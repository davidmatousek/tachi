          "name": "CWE",
          "version": "4.13",
          "informationUri": "https://cwe.mitre.org/",
          "organization": "MITRE",
          "shortDescription": {
            "text": "Common Weakness Enumeration"
          }
        }
      ],
      "results": [
        {
          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "A shared or long-lived webhook signature on partner-feed lets anyone who obtains one copy authenticate as every tenant that uses the same deployment profile. [Control: missing]"
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "partner-feed",
                  "fullyQualifiedName": "Public Internet/partner-feed",
                  "kind": "external-entity"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "8114dfb10eff25e1",
            "findingId/v1": "S-3"
          },
          "properties": {
            "security-severity": "9.1",
            "control-status": "missing",
            "control-evidence": [],
            "control-carry-forward": false,
            "control-effectiveness": "none",
            "maestro-layer": "L7 \u2014 Agent Ecosystem",
            "inherent-risk": "9.1",
            "residual-risk": "9.1",
            "recommendation": "Implement access control for partner-feed. Evaluate the original caller's entitlement for each object and action, and deny by default when the check cannot be made. Place the control where signed carrier manifests are first received, so that nothing downstream has to repeat the check. This addresses: A shared or long-lived webhook signature on partner-feed lets anyone who obtains one copy authenticate as every tenant that uses the same deployment profile. Acceptance check: a caller without the entitlement is denied for every object and action, including through indirect paths, and the denial is recorded. Ship to the internal environment first, compare behaviour with the previous release and promote after reviewing the first week of records. Suggested location: stub-codebase/src/partner_feed/access_control.py. Reference patterns: Role and attribute checks at the service boundary, deny-by-default policy.",
            "effort-estimate": "High"
          }
        },
