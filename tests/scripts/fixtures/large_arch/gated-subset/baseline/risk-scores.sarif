        {
          "ruleId": "tachi/ai/llm-threats",
          "message": {
            "text": "edge-gateway passes conversation history from earlier turns into the model unchanged, so an injection planted earlier keeps working in later turns.",
            "markdown": "Re-screen conversation history on each turn in edge-gateway, expire old turns and mark which turns came from untrusted sources."
          },
          "level": "warning",
