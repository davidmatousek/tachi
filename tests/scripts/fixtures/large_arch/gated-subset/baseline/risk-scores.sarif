        {
          "ruleId": "tachi/stride/denial-of-service",
          "message": {
            "text": "A dependency of edge-gateway becomes unavailable and the failure cascades because edge-gateway waits on it synchronously for every request.",
            "markdown": "Isolate calls from edge-gateway to the dependency with timeouts and bulkheads, serve degraded results where possible and alert on dependency health."
          },
