        {
          "ruleId": "tachi/stride/elevation-of-privilege",
          "message": {
            "text": "Object identifiers in requests to edge-gateway are trusted without an ownership check, so a caller can read or change inbound API requests that belong to others. [Control: missing]"
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "edge-gateway",
                  "fullyQualifiedName": "Edge DMZ/edge-gateway",
                  "kind": "process"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "b519ad7937a2e79a",
            "findingId/v1": "E-1"
          },
          "properties": {
            "security-severity": "8.0",
            "control-status": "missing",
            "control-evidence": [],
            "control-carry-forward": false,
            "control-effectiveness": "none",
            "maestro-layer": "L4 \u2014 Deployment Infrastructure",
            "inherent-risk": "8.0",
            "residual-risk": "8.0",
            "recommendation": "Implement access control for edge-gateway. Evaluate the original caller's entitlement for each object and action, and deny by default when the check cannot be made. Place the control where inbound API requests are first received, so that nothing downstream has to repeat the check. This addresses: Object identifiers in requests to edge-gateway are trusted without an ownership check, so a caller can read or change inbound API requests that belong to others. Acceptance check: a caller without the entitlement is denied for every object and action, including through indirect paths, and the denial is recorded. Ship to the internal environment first, compare behaviour with the previous release and promote after reviewing the first week of records. Suggested location: stub-codebase/src/edge_gateway/access_control.py. Reference patterns: Role and attribute checks at the service boundary, deny-by-default policy.",
            "effort-estimate": "High"
          }
        },
        {
          "ruleId": "tachi/stride/tampering",
          "message": {
            "text": "Unsanitised credential assertions and session grants reach auth-broker and are processed as trusted structure, so crafted input changes how later steps interpret the record. [Control: missing]"
          },
          "level": "warning",
          "locations": [
