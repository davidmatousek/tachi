        {
          "ruleId": "tachi/stride/tampering",
          "message": {
            "text": "An attacker who can write to the channel between tool-server-1 and audit-ledger modifies approval and tool call records in transit because messages carry no integrity protection of their own. audit-ledger runs in the Operations Zone and exchanges approval and tool call records with tool-server-1 over gRPC over mTLS, so anything able to reach tool-server-1 can also reach this weakness. Altered data is then treated as authoritative by every consumer, so the damage spreads before anyone compares it with the source. Rated MEDIUM likelihood because the path needs a foothold on a neighbouring service or a prepared request, and LOW impact because the effect is contained and easy to reverse once it is noticed.",
            "markdown": "Sign messages between tool-server-1 and audit-ledger with a per-service key and verify the signature and a monotonic counter before accepting any change. Name an owner for this control, review it each quarter and route violations to audit-ledger so that responders see them in one place."
          },
          "level": "note",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "docs/security/architecture.md"
                },
                "region": {
                  "startLine": 1
                }
              },
              "logicalLocations": [
                {
                  "name": "audit-ledger",
                  "fullyQualifiedName": "Operations Zone/audit-ledger",
                  "kind": "data-store"
                }
              ]
            }
          ],
          "partialFingerprints": {
            "primaryLocationLineHash": "109140cfcc16425b",
            "findingId/v1": "T-3",
            "baselineRunId": "2026-09-21T09-12-00"
          },
          "properties": {
