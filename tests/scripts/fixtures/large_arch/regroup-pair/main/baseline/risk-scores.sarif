          "ruleId": "tachi/stride/information-disclosure",
          "message": {
            "text": "Secrets such as the bearer token for edge-gateway appear in process arguments and environment dumps that diagnostic tooling captures.",
            "markdown": "Pass the bearer token to edge-gateway through a secret manager mount, exclude it from process listings and diagnostics, and rotate it after any exposure."
          },
