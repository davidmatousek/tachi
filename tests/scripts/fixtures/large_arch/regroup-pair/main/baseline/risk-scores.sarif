          "ruleId": "tachi/stride/repudiation",
          "message": {
            "text": "Clock drift between intake-agent and edge-gateway leaves events in inconsistent order, so the sequence of actions on free-text shipment requests cannot be reconstructed reliably.",
            "markdown": "Synchronise intake-agent and edge-gateway to a trusted time source, record monotonic sequence numbers with every event and alert when drift exceeds one second."
          },
