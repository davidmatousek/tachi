        {
          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "An attacker replays a captured session cookie against client-portal, which does not bind the credential to the session or channel it was issued for, so the replay is accepted as the original caller.",
            "markdown": "Bind each session cookie to the client certificate or device key, shorten its lifetime to minutes and reject any token presented from a different channel than the one it was issued to."
          },
          "level": "error",
