          "properties": {
            "tags": [
              "maestro-layer:L6"
            ],
            "maestro-layer": "L6 — Security and Compliance",
            "affected_assets": []
          }
        },
        {
          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "The Orchestrator's identity is not cryptographically attested to the Specialist Agent over the Inter-Agent Channel, letting a rogue process inject delegation instructions that appear to originate from the Orchestrator.",
            "markdown": "Sign every Orchestrator→Channel message (HMAC or asymmetric, per-session keys); require the Specialist to verify the signature and a replay-preventing nonce before acting."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "examples/agentic-app/test-output/t017-fallback-2026-07-03T12-30-15/architecture.md"
