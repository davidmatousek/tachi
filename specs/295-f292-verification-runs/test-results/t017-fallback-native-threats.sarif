            "affected_assets": []
          }
        },
        {
          "ruleId": "tachi/ai/llm-threats",
          "message": {
            "text": "The Orchestrator's `Tool Call Request (JSON-RPC)` carries LLM-synthesized parameters into the MCP Tool Server. Without parameterization, an attacker who influences Orchestrator output can achieve **server-side** SQL/command/template injection at the Tool Server's execution context.",
            "markdown": "Parameterize all LLM-supplied tool inputs (`cursor.execute(sql, params)`, `subprocess.run([...], shell=False)`); validate against a closed per-tool allowlist before dispatch."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
