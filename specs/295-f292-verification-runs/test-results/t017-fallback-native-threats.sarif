        {
          "ruleId": "tachi/ai/llm-threats",
          "message": {
            "text": "If the Orchestrator incorporates ClinAdvisor's `Clinical Summary + Recommendations` into a subsequent `Tool Call Request` without sanitization, adversarial content injected into the clinical output can achieve **server-side** execution at the Tool Server, one hop downstream of the sub-agent's own output.",
            "markdown": "Treat ClinAdvisor output as untrusted at the Orchestrator; apply the same parameterization and schema validation as OI-2 before any downstream tool invocation."
          },
          "level": "error",
          "locations": [
            {
              "physicalLocation": {
