            "affected_assets": []
          }
        },
        {
          "ruleId": "tachi/stride/spoofing",
          "message": {
            "text": "A compromised Specialist Agent can inject fabricated \"Aggregated Result\" messages back through the Channel, impersonating legitimate specialist output to the Orchestrator.",
            "markdown": "Sign all Specialist→Channel messages with the Specialist's own key; the Orchestrator MUST verify origin before incorporating results into context."
          },
          "level": "error",
          "locations": [
